{
  "name": "vault-to-foundry",
  "private": true,
  "license": "MIT",
  "version": "1.0.10",
  "type": "module",
  "workspaces": [
    "packages/*",
    "systems/*/adapter"
  ],
  "scripts": {
    "prebuild": "node tools/ensure-deps.mjs",
    "build": "node tools/build.mjs",
    "predev": "node tools/ensure-deps.mjs",
    "dev": "node tools/build.mjs --watch --deploy",
    "predeploy": "node tools/ensure-deps.mjs",
    "deploy": "node tools/build.mjs --deploy",
    "pretest": "node tools/ensure-deps.mjs",
    "test": "vitest run",
    "pretypecheck": "node tools/ensure-deps.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "export:test": "node --experimental-strip-types tools/export-cli.ts",
    "foundry": "tools/foundry-local.sh",
    "e2e": "tools/e2e/run-all.sh",
    "sync-local": "tools/sync-local.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
