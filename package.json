{
  "name": "vault-to-foundry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "systems/*/adapter",
    "systems/*/nsc-generator",
    "systems/*/nsc-generator-plugin"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch --deploy",
    "deploy": "node tools/build.mjs --deploy",
    "build:generator": "node systems/dsa41/nsc-generator-plugin/build.mjs",
    "dev:generator": "node systems/dsa41/nsc-generator-plugin/build.mjs --watch --deploy",
    "test": "vitest run",
    "typecheck": "node tools/typecheck.mjs",
    "export:test": "node --experimental-strip-types tools/export-cli.ts",
    "foundry": "tools/foundry-local.sh",
    "e2e": "tools/e2e/run-all.sh",
    "sync-local": "tools/sync-local.sh",
    "regelwerke": "node systems/dsa41/tools/regelwerke.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
